# public artifact on purpose. Keep it untracked.
CONTEXT.md

# --- Eval run outputs -------------------------------------------------------------
# Ignore run logs by default; keep the directory and any deliberately committed
# baseline snapshots used as regression references.
runs/*
!runs/.gitkeep
!runs/baselines/
logs/
*.eval

