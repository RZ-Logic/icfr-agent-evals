# --- Private working notes: never publish ---------------------------------------
# CONTEXT.md holds private strategy and audience-specific framing kept out of the
# public artifact on purpose. Keep it untracked.
CONTEXT.md

# --- Eval run outputs -------------------------------------------------------------
# Ignore run logs by default; keep the directory and the two committed CI
# baselines (pre-registration section 10). The re-allows must follow *.eval.
runs/*
!runs/.gitkeep
logs/
*.eval
!runs/baseline-phase-1.eval
!runs/baseline-phase-2.eval

