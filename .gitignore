# --- Private working notes: never publish ---------------------------------------
# CONTEXT.md holds private strategy and audience-specific framing kept out of the
# public artifact on purpose. Keep it untracked.
CONTEXT.md

# --- Eval run outputs -------------------------------------------------------------
# Ignore run logs by default; keep the directory, the two committed CI baselines
# (pre-registration section 10) and the pilot logs copied into runs/pilot-<date>/
# as evidence (docs/evidence/PILOT-RUNBOOK.md). The re-allows must follow *.eval.
runs/*
!runs/.gitkeep
logs/
*.eval
!runs/baseline-phase-1.eval
!runs/baseline-phase-2.eval
!runs/pilot-*/
!runs/pilot-*/**/*.eval

# --- Python -----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
